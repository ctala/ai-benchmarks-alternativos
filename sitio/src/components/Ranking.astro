---
// Un ranking «Mejor LLM para…». Todo lo que la página afirma (veredicto, grupo de cabeza, top 3
// con la regla del ruido, frontera, guía de lectura) llega calculado de `sitio_rankings.py`; acá
// se elige la frase según el dato y se dibuja. Ninguna frase sobre los modelos es fija: cada una
// depende de un campo, y cada cifra va por <Cifra>/<Eje> (R2) y cada modelo por <Modelo> (R1).
import Base from '../layouts/Base.astro';
import Cifra from './Cifra.astro';
import Eje from './Eje.astro';
import Modelo from './Modelo.astro';
import Nombre from './Nombre.astro';
import Kicker from './Kicker.astro';
import Titulo from './Titulo.astro';
import Metodologia from './Metodologia.astro';
import Funnel from './Funnel.astro';
import QueMide from './QueMide.astro';
import Alcance from './Alcance.astro';

interface Props { r: any; meta: any }
const { r, meta } = Astro.props;
const P = meta.pilares as string[];
const ag = r.criterio === 'agentes';
const v = r.veredicto;
const g = r.cabeza;
const s = r.solo;
const cr = r.criterio;
const precio = (x: any) => `$${x.costo_in.toFixed(2)} / $${x.costo_out.toFixed(2)}`;
const usd = (x: number) => (x < 10 ? `$${x.toFixed(2)}` : `$${Math.round(x).toLocaleString('es-CL')}`);
const ejeTxt = (x: any) => ag ? (x.harbor ? `${x.harbor.superadas} de ${x.harbor.de} tareas agénticas` : 'sin dato agéntico')
                              : (x.nota == null ? '—' : `${x.nota.toFixed(1)}/10`);
const quienes = g ? (g.primeros ? `a los primeros ${g.n}` : `a estos ${g.n} modelos de la cima`) : '';
const porQueEmpatan = ag
  ? 'superan las mismas tareas agénticas en todos sus intentos, así que la medición no tiene con qué separarlos'
  : 'la diferencia entre ellos es menor que el margen de error de la medición';
const porQueSepara = ag ? 'supera más tareas agénticas que el siguiente' : 'su diferencia con el siguiente es mayor que el margen de error';

// La descripción y la FAQ en texto plano (JSON-LD): mismas decisiones que el HTML de abajo.
const cierre = g ? (ag ? `${g.n} modelos superan ${ejeTxt(g.eje_lider)}; el más barato es ${g.barato.name}.`
                       : `El benchmark no separa a ${g.n} modelos de la cima; el más barato del grupo es ${g.barato.name}.`)
           : s ? `Queda solo arriba: ${s.lider.name}.` : `El más barato: ${r.filas[0].name}.`;
const descripcion = `${r.h1} con ${meta.runs_k.toLocaleString('es-CL')}+ runs reales: ranking por ${r.caso}. Incluye costos para volumen y dónde quedan los modelos frontier. ${cierre}`;
const etiquetaCaso = r.caso.split('(')[0].trim();
const q1 = g
  ? { q: `¿Cuál es el mejor LLM para ${etiquetaCaso} hoy?`,
      a: `En ${r.que}, el benchmark no separa ${quienes}. El más barato del grupo es ${g.barato.name}. No hay un único «mejor»: ${porQueEmpatan}.` }
  : s
    ? { q: `¿Cuál es el mejor LLM para ${etiquetaCaso} hoy?`,
        a: `Según nuestro benchmark, ${s.lider.name} queda solo arriba en ${r.que} con ${ejeTxt(s.lider)}: ${porQueSepara}.` }
    : { q: `¿Cuál es el LLM más barato para ${etiquetaCaso} hoy?`,
        a: `${r.filas[0].name}, entre los modelos que pasan el piso de calidad de esta página.` };
const faq = [
  q1,
  { q: '¿Para qué casos NO sirve este ranking?',
    a: `Si tu caso es muy distinto a ${r.que} (por ejemplo, necesitas razonamiento profundo, tool calling crítico o privacidad extrema), probablemente haya mejores opciones. Usa la calculadora para ajustar pesos por caso.` },
  { q: '¿De dónde salen estos datos?',
    a: `De un benchmark abierto con ${meta.runs_k.toLocaleString('es-CL')}+ runs reales y LLM-as-Judge (Phi-4, de Microsoft, vía OpenRouter, sin conflicto de interés). Código y resultados en GitHub.` },
  { q: '¿Cada cuánto se actualiza?',
    a: 'Con cada lote de modelos nuevos. La fecha de actualización está al inicio. Filtra la versión más reciente en la calculadora.' },
];
const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
}, null, 2);
const datasetLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: `Ranking de ${r.que} - Benchmark Alternativos`,
  description: `Ranking de modelos LLM para ${r.que} basado en ${meta.runs_k.toLocaleString('es-CL')}+ runs reales.`,
  url: r.url, creator: { '@type': 'Person', name: 'Cristian Tala', url: 'https://cristiantala.com' },
  datePublished: r.fecha_publicada, dateModified: meta.hoy, license: 'https://opensource.org/licenses/MIT',
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json',
    contentUrl: 'https://github.com/ctala/ai-benchmarks-alternativos/tree/main/benchmarks/results' }],
}, null, 2);
const fam = r.frontera.filter((f: any) => f.m);
const sinFam = r.frontera.filter((f: any) => !f.m);
---
<Base titulo={r.titulo} descripcion={descripcion} keywords={r.keywords} url={r.url}
      publicada={r.fecha_publicada} modificada={meta.hoy} contrato={r.contrato_html}>

  <section class="hero">
    <Kicker>ranking</Kicker>
    <Titulo nivel={1} texto={r.h1}><span data-nombre>{r.h1}</span></Titulo>
    <p class="lead">{r.lead.map((p: any) => typeof p === 'string' ? p : <Cifra v={p.cifra} d={p.d || 0} />)}</p>
    <p class="meta">Última actualización: {meta.hoy} · <a href="https://github.com/ctala/ai-benchmarks-alternativos" target="_blank" rel="noopener">datos abiertos en GitHub</a></p>
  </section>

  {v && (
    <section class="veredicto">
      <Kicker>la respuesta corta</Kicker>
      <Titulo texto="La respuesta corta">La respuesta corta</Titulo>
      {v.inconcluso ? (
        <>
          <p class="lead"><Alcance a={r.alcance.partes} />, el benchmark <strong>no logra separar a los modelos</strong>: <Cifra v={v.n} /> de <Cifra v={v.pool} /> (<Cifra v={v.pct} suf=" %" /> del catálogo) quedan dentro del margen de error en esta tarea. Cuando la medición no distingue, lo honesto es decirlo, no inventar un ganador.</p>
          <p class="lead">Con esa salvedad, dentro del grupo elige por precio: el más barato es <span data-afirmacion="mejor_compra"><Modelo m={v.mejor} fuerte /></span>, por <strong>≈<Cifra v={v.mejor.mes} d={v.mejor.mes < 10 ? 2 : 0} pre="$" suf="/mes" /></strong>. Ninguno del grupo le saca una diferencia demostrable. <strong>Prueba con tus propios prompts</strong>: este benchmark no va a decidir por ti.</p>
        </>
      ) : (
        <>
          <p class="lead"><Alcance a={r.alcance.partes} />, {ag
            ? (v.n <= 1
                ? <><Modelo m={v.mejor} fuerte /> es el único que supera <Eje x={v.mejor} ag largo /> en todos sus intentos.</>
                : <><strong><Cifra v={v.n} /> modelos superan <Eje x={v.mejor} ag largo /></strong> en todos sus intentos, así que la medición no tiene con qué separarlos. <strong>Entre ellos, elige por precio</strong>.</>)
            : (v.n <= 1
                ? <><Modelo m={v.lider} fuerte /> encabeza la tabla y <strong>nadie empata con él</strong>: la diferencia con el siguiente es mayor que el margen de error de la medición.</>
                : <><strong>el benchmark no separa a <Cifra v={v.n} /> modelos de la cima</strong>: la diferencia entre ellos es más chica que el margen de error de la medición. <strong>Dentro del grupo, elige por precio</strong>.</>)}</p>
          {!ag && v.n > 1 && r.alcance.n_saturadas > 0 && (
            <p class="meta">{r.alcance.n_saturadas === r.alcance.n_suites
              ? <>En {r.alcance.n_suites === 1 ? 'esa suite' : <>las <Cifra v={r.alcance.n_suites} /> suites</>} los del grupo quedan dentro del margen de error del mejor modelo de la suite: <strong>{r.alcance.n_suites === 1 ? 'está saturada' : 'están saturadas'} y no los discriminan</strong>. Que no los separe no prueba que rindan igual en tu caso.</>
              : <>En <Cifra v={r.alcance.n_saturadas} /> de esas suites los del grupo quedan dentro del margen de error del mejor modelo de la suite: <strong>están saturadas y no los discriminan</strong>.</>}</p>
          )}
          <div class="veredicto-grid">
            <div class="card card-destacada veredicto-carta" data-afirmacion="mejor_compra">
              <span class="veredicto-tag">{v.n <= 1 ? (ag ? 'El único del grupo' : (v.mismo ? 'El mejor, y además el más barato' : 'La mejor compra del grupo')) : 'La mejor compra del grupo'}</span>
              <Modelo m={v.mejor} fuerte />
              <span class="veredicto-costo">≈<Cifra v={v.mejor.mes} d={v.mejor.mes < 10 ? 2 : 0} pre="$" suf="/mes" /></span>
              <span class="meta">{ag ? <Eje x={v.mejor} ag largo /> : <>calidad <Cifra v={v.mejor.calidad} d={2} suf="/10" /></>}{v.n > 1 && (ag ? <> · el más barato de los <Cifra v={v.n} /></> : ' · el más barato del grupo de cabeza')}</span>
            </div>
            {!ag && !v.mismo && v.n > 1 && (
              <div class="card veredicto-carta">
                <span class="veredicto-tag">Del mismo grupo, el de nota más alta</span>
                <Modelo m={v.lider} fuerte />
                <span class="veredicto-costo">≈<Cifra v={v.lider.mes} d={v.lider.mes < 10 ? 2 : 0} pre="$" suf="/mes" /></span>
                <span class="meta">calidad <Cifra v={v.lider.calidad} d={2} suf="/10" /> · su diferencia con la mejor compra está dentro del margen de error</span>
              </div>
            )}
            {v.caro && v.caro.key !== v.lider.key && (
              <div class="card veredicto-carta">
                <span class="veredicto-tag">Lo que te ahorras</span>
                <Modelo m={v.caro} fuerte />
                <span class="veredicto-costo">≈<Cifra v={v.caro.mes} d={v.caro.mes < 10 ? 2 : 0} pre="$" suf="/mes" /></span>
                <span class="meta">{v.caro.veces ? <><Cifra v={v.caro.veces} suf="×" /> más caro</> : 'más caro'} {ag ? 'por las mismas tareas superadas' : <>por <Cifra v={v.caro.brecha} d={2} pre={v.caro.brecha >= 0 ? '+' : ''} /> de calidad, dentro del margen de error</>}</span>
              </div>
            )}
            {v.local && (
              <div class="card veredicto-carta">
                <span class="veredicto-tag">Si tienes hardware propio</span>
                <Modelo m={v.local} fuerte />
                <span class="veredicto-costo">≈<Cifra v={v.local.mes} d={v.local.mes < 10 ? 2 : 0} pre="$" suf="/mes" /></span>
                <span class="meta">{ag ? <Eje x={v.local} ag largo /> : <>calidad <Cifra v={v.local.calidad} d={2} suf="/10" /></>} · corre local, sin API</span>
              </div>
            )}
          </div>
        </>
      )}
      <p class="meta">Cálculo sobre <strong><Cifra v={3000} /> llamadas al mes</strong> (unas <Cifra v={100} /> por día). ¿Otro volumen, o te importa más la velocidad? Ajusta los pesos en la <a href={v.calc}>calculadora</a>. Los modelos citados están en la tabla de abajo, marcados.</p>
    </section>
  )}

  <section class="results" data-grupo-cabeza={g ? g.keys.join(',') : ''}>
    <Kicker>tabla</Kicker>
    <Titulo texto={`Ranking: ${r.h1}`}>Ranking: <span data-nombre>{r.h1}</span></Titulo>
    <p class="meta">{ag ? <>Ordenado por <strong>lo que el modelo logró haciendo el trabajo</strong>: tareas reales de negocio ejecutadas dentro de un agente, con herramientas, en Docker. Cuenta el peor de los intentos, no el promedio: para algo que corre solo, «a veces falla» y «no falla» no son lo mismo. La columna «Agentes» de más a la derecha es otra cosa: mide escribir <em>sobre</em> agentes, y por eso puede ir al revés.</>
      : cr === 'pillar' ? <>Ordenado por <strong>capacidad pura en esta tarea</strong>: solo calidad, sin ponderar costo ni velocidad. El precio se muestra aparte, para decidir después.</>
      : cr === 'suite' ? <>Ordenado por la calidad en esta suite (<Nombre>{r.suite}</Nombre>), sin ponderar costo ni velocidad. Al lado, la nota de calidad global y su puesto: un corte por eje sin el global es tan parcial como el global sin el eje.</>
      : cr === 'cost' ? <>Ordenado por lo que cuestan <Cifra v={1000} /> llamadas (<Cifra v={300} /> tokens de entrada y <Cifra v={1500} /> de salida cada una), entre los modelos con calidad ≥ <Cifra v={r.min_calidad} d={1} />.</>
      : <>Ordenado por la nota de calidad (examen más tareas reales de agente), solo modelos con pesos abiertos.</>}
      {g && <> «≈» marca a los del grupo de cabeza: el benchmark no los separa.</>}</p>
    <div class="tabla-scroll"><table class="results-table">
      <thead><tr>
        <th scope="col" class="num">#</th><th scope="col">Modelo</th>
        {cr === 'cost' && <th scope="col" class="num">US$ por <Cifra v={1000} /> llamadas</th>}
        {(cr === 'pillar' || ag || cr === 'suite') && <th scope="col" class="num">{r.etiqueta}</th>}
        {(cr === 'suite' || cr === 'cost' || cr === 'open_source') && <th scope="col" class="num">Calidad</th>}
        {cr === 'suite' && <th scope="col" class="num">Puesto en calidad</th>}
        {cr !== 'suite' && P.map((p) => <th scope="col" class="num">{p === 'Razonamiento' ? 'Razon.' : p}</th>)}
        <th scope="col" class="num">US$ in / out por M</th><th scope="col" class="num">Velocidad</th>
      </tr></thead>
      <tbody>
        {r.filas.map((f: any) => (
          <tr>
            <td class="num">{f.marca === '≈' ? '≈' : <Cifra v={f.marca} />}</td>
            <td><Modelo m={f} fuerte={f.top} />{f.badge && <span class="etiqueta-fila">{f.badge}</span>}</td>
            {cr === 'cost' && <td class="num"><strong><Cifra v={f.c1k} d={2} pre="$" /></strong></td>}
            {(cr === 'pillar' || ag || cr === 'suite') && <td class="num"><strong><Eje x={f} ag={ag} suf="" /></strong></td>}
            {(cr === 'suite' || cr === 'cost' || cr === 'open_source') && <td class="num"><Cifra v={f.calidad} d={2} /></td>}
            {cr === 'suite' && <td class:list={['num', { contraste: f.contraste }]}>{f.puesto_global ? <Cifra v={f.puesto_global} pre="#" suf={` de ${f.total_global}`} /> : '—'}</td>}
            {cr !== 'suite' && P.map((p) => <td class="num"><Cifra v={f.pilares[p]} d={1} /></td>)}
            <td class="num" data-cifra>{precio(f)}</td>
            <td class="num"><Cifra v={f.tps} suf=" tok/s" /></td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="meta">Filtra por presupuesto, calidad mínima o tarea en la <a href="/">calculadora interactiva</a>.</p>
  </section>

  {r.segunda && (
    <section class="results">
      <Kicker>por lo que cuesta</Kicker>
      <Titulo texto="La misma capacidad, por lo que cuesta">La misma capacidad, por lo que cuesta</Titulo>
      {r.segunda.tipo === 'agentes' ? (
        <>
          <p class="meta">La tabla de arriba responde «¿quién lo hace mejor?». Esta responde la de producción: <strong>de los que superan más tareas, cuál cuesta menos</strong>. Ordena por tareas agénticas superadas y, a igualdad, por precio.</p>
          <p class="meta"><Cifra v={r.segunda.n_tope} /> de <Cifra v={r.segunda.n} /> modelos superan <Eje x={{ harbor: r.segunda.tope }} ag largo /> en todos sus intentos. Entre ellos, lo que decide es el precio.</p>
        </>
      ) : (
        <>
          <p class="meta">La tabla de arriba ordena por capacidad y nada más. Esta responde la pregunta de producción: <strong>de los que pueden, cuál conviene</strong>. Fórmula: <Cifra v={70} suf=" %" /> capacidad y <Cifra v={30} suf=" %" /> precio, con la misma curva de costo que usa el resto del benchmark.</p>
          <p class="meta">Se publica porque los dos órdenes se parecen poco: la correlación entre los puestos de una tabla y de la otra es <Cifra v={r.segunda.r} d={2} />. Cuando es alta, la segunda tabla repetiría la primera y no se muestra.</p>
        </>
      )}
      <div class="tabla-scroll"><table class="results-table">
        <thead><tr>
          <th scope="col" class="num">#</th><th scope="col">Modelo</th>
          {r.segunda.tipo === 'valor' && <th scope="col" class="num">Calidad×precio</th>}
          <th scope="col" class="num">{r.etiqueta}</th>
          <th scope="col" class="num">US$ por <Cifra v={1000} /> llamadas</th><th scope="col" class="num">Velocidad</th>
        </tr></thead>
        <tbody>
          {r.segunda.filas.map((f: any) => (
            <tr>
              <td class="num"><Cifra v={f.rank} /></td>
              <td><Modelo m={f} fuerte={f.rank === 1} /></td>
              {r.segunda.tipo === 'valor' && <td class="num"><strong><Cifra v={f.valor} d={2} /></strong></td>}
              <td class="num"><Eje x={f} ag={ag} suf="" /></td>
              <td class="num"><Cifra v={f.c1k} d={2} pre="$" /></td>
              <td class="num"><Cifra v={f.tps} suf=" tok/s" /></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  <section>
    <Kicker>cómo leerlo</Kicker>
    <Titulo texto={`Cómo interpretar este ranking de ${r.que}`}>Cómo interpretar este ranking de <span data-nombre>{r.que}</span></Titulo>
    <p>{cr === 'cost'
      ? <>Este ranking ordena por <strong>precio</strong>: de los modelos que pasan el piso de calidad, primero el más barato. Sirve para {r.usos.join(', ')}.</>
      : cr === 'open_source'
        ? <>Este ranking ordena por la <strong>nota de calidad</strong>, solo entre modelos con pesos abiertos. Sirve para {r.usos.join(', ')}.</>
        : <>Este ranking no mide «inteligencia general» ni el score global. Mide qué modelo rinde mejor para <strong>{r.que}</strong> en casos reales: {r.usos.join(', ')}. El orden depende solo de la nota de esa tarea, no del costo, la velocidad ni la latencia.</>}</p>
    <p>{g
      ? <>En esta dimensión el benchmark no separa {g.primeros ? <>a los primeros <Cifra v={g.n} /></> : <>a estos <Cifra v={g.n} /> modelos de la cima</>}{g.margen && <> (margen de error ±<Cifra v={g.margen} d={2} />)</>}. {ag
          ? <>Los <Cifra v={g.n} /> superan <Eje x={g.eje_lider} ag largo /> en todos sus intentos, así que la medición no tiene con qué separarlos.</>
          : <>Rondan los <Eje x={g.eje_lider} ag={false} /> y la diferencia entre ellos es menor que el margen de error de la medición.</>}</>
      : s
        ? <>En esta dimensión <Modelo m={s.lider} fuerte /> queda solo arriba: {porQueSepara}{s.segundo && <> (el siguiente es <Modelo m={s.segundo} />, con <Eje x={s.segundo} ag={ag} />)</>}.</>
        : <>Acá el orden lo decide el precio, que es un dato exacto: no hay empates que declarar.</>}
      {' '}Si tu prioridad es costo, velocidad o privacidad, el orden puede cambiar: el score global de la calculadora pondera calidad (<Cifra v={meta.pesos.quality} d={Number.isInteger(meta.pesos.quality) ? 0 : 1} suf=" %" />), costo (<Cifra v={meta.pesos.cost} d={Number.isInteger(meta.pesos.cost) ? 0 : 1} suf=" %" />), velocidad (<Cifra v={meta.pesos.speed} d={Number.isInteger(meta.pesos.speed) ? 0 : 1} suf=" %" />) y latencia (<Cifra v={meta.pesos.latency} d={Number.isInteger(meta.pesos.latency) ? 0 : 1} suf=" %" />). Ajusta esos pesos en la <a href="/">calculadora</a> para tu caso.</p>
    <p>Solo entran modelos del ranking vigente: rindieron el examen completo, con al menos <Cifra v={r.min_runs} /> runs.</p>
  </section>

  <section>
    <Kicker>los tres primeros</Kicker>
    {g ? (
      <Titulo texto="El grupo de cabeza: los modelos que el benchmark no separa">El grupo de cabeza: <Cifra v={g.n} /> modelos que el benchmark no separa</Titulo>
    ) : (
      <Titulo texto="Los tres primeros, explicados">Los tres primeros, explicados</Titulo>
    )}
    <p>{cr === 'cost'
      ? <>Los tres más baratos de los que pasan el piso de calidad. El precio no tiene margen de error, así que el orden es exacto.</>
      : <>Con la regla del ruido: dentro del margen de error se marca «≈» y va primero el más barato; un modelo que se separa de los demás conserva su puesto.{g && <> {porQueEmpatan.charAt(0).toUpperCase() + porQueEmpatan.slice(1)}: la decisión es de precio.</>}</>}</p>
    {r.top3.map((x: any) => (
      <>
        <h3 data-afirmacion="top3">{x.marca === '≈' ? '≈' : <Cifra v={x.marca} pre="#" />} <Modelo m={x} /> · <Eje x={x} ag={ag} largo /></h3>
        <p><Modelo m={x} /> (<Nombre>{x.proveedor}</Nombre>, {x.abierto ? 'open source' : 'propietario'}) cuesta <span data-cifra>{precio(x)}</span> por millón de tokens y rinde a <Cifra v={x.tps} suf=" tok/s" />. {x.en_grupo
          ? (ag ? 'Está en el grupo de cabeza: supera las mismas tareas que el resto del grupo.' : 'Está en el grupo de cabeza: su nota no se distingue de la del resto del grupo.')
          : x.marca === '≈' ? 'Empata dentro del margen de error con los de su banda.'
          : cr === 'cost' ? 'Pasa el piso de calidad de esta página.' : 'Se separa de los demás por más que el margen de error.'}
          {x.abierto ? ' Tiene pesos abiertos, así que puedes correrlo en varios proveedores o local.' : ''}</p>
      </>
    ))}
  </section>

  {g && (
    <section>
      <Kicker>quiénes encabezan</Kicker>
      <Titulo texto="Quiénes encabezan">Quiénes encabezan</Titulo>
      <p>Para {r.caso}, el benchmark no separa {g.primeros ? <>a los primeros <Cifra v={g.n} /></> : <>a estos <Cifra v={g.n} /> modelos de la cima</>}: {g.nombres.map((m: any, i: number) => <>{i > 0 && (i === g.nombres.length - 1 && !g.mas ? ' y ' : ', ')}<Modelo m={m} /></>)}{g.mas > 0 && <> y <Cifra v={g.mas} /> más</>}. {porQueEmpatan.charAt(0).toUpperCase() + porQueEmpatan.slice(1)}, y ordenarlos por puesto sería inventar una diferencia que la medición no tiene.</p>
      <p>Dentro del grupo, el más barato es <Modelo m={g.barato} fuerte />, a <span data-cifra>{precio(g.barato)}</span> por millón de tokens. Antes de pagar más por otro del grupo, pruébalos con tus propios prompts.</p>
    </section>
  )}

  <section class="results">
    <Kicker>costo real</Kicker>
    <Titulo texto="Costo real para volumen">Costo real para volumen</Titulo>
    <p>Los tres de arriba, a <Cifra v={1000} /> y <Cifra v={10000} /> llamadas al mes (<Cifra v={300} /> tokens de entrada y <Cifra v={1500} /> de salida por llamada, el promedio del benchmark):</p>
    <div class="tabla-scroll"><table class="results-table">
      <thead><tr><th scope="col">Modelo</th><th scope="col" class="num">US$ por M tokens</th><th scope="col" class="num"><Cifra v={1000} suf=" llamadas/mes" /></th><th scope="col" class="num"><Cifra v={10000} suf=" llamadas/mes" /></th></tr></thead>
      <tbody>
        {r.top3.map((x: any) => (
          <tr><td><Modelo m={x} /></td><td class="num" data-cifra>{precio(x)}</td>
            <td class="num"><Cifra v={x.c1k} d={2} pre="$" /></td>
            <td class="num" data-cifra>{usd(x.c1k * 10)}</td></tr>
        ))}
      </tbody>
    </table></div>
    <p class="meta">Con volumen alto, un modelo más barato puede ahorrarte más de lo que pierdes en calidad. Valida con tu caso real en la <a href="/">calculadora</a>.</p>
  </section>

  {fam.length > 0 && (
    <section>
      <Kicker>frontier</Kicker>
      <Titulo texto="¿Dónde quedan los modelos frontier?">¿Dónde quedan los modelos frontier?</Titulo>
      <p>Mucha gente llega buscando a los laboratorios grandes{r.frontera_abierta && ' que publican pesos abiertos'}. De cada familia, su modelo mejor ubicado <strong>en esta tarea concreta</strong>, por su lugar en esta tabla y no por lo que cuesta{g && ' (dentro del grupo de cabeza no hay puesto: el benchmark no los separa)'}:</p>
      <ul class="frontera">
        {fam.map((f: any) => (
          <li data-afirmacion="frontera"><span class="frontera-familia" data-nombre>{f.etiqueta}</span>
            <Modelo m={f.m} fuerte />
            {f.m.en_grupo
              ? <span class="frontera-pos frontera-top">≈ grupo de cabeza</span>
              : <span class:list={['frontera-pos', { 'frontera-top': f.m.pos <= 10 }]}><Cifra v={f.m.pos} pre="#" />{f.m.pos <= 10 && <> · entre los <Cifra v={10} /> primeros</>}</span>}
            <span><Eje x={f.m} ag={ag} /></span>
            <span class="meta"><span data-cifra>{precio(f.m)}</span> por millón</span></li>
        ))}
      </ul>
      {sinFam.length > 0 && <p class="meta">Sin modelo en este ranking: {sinFam.map((f: any, i: number) => <>{i > 0 && ', '}<span data-nombre>{f.etiqueta}</span></>)}.</p>}
      <p class="meta">Para una comparación cara a cara, mira <a href={r.comparativa_frontera.href}>{r.comparativa_frontera.texto}</a> o ajusta los pesos en la <a href="/">calculadora</a>.</p>
    </section>
  )}

  <Funnel>Ya tienes un candidato. No lo cambies a ciegas: toma los dos primeros de la tabla y pásales <strong>cinco prompts reales tuyos</strong>, de los que ya corres en producción. Un benchmark general te dice quién arranca adelante; <strong>tu caso decide quién gana</strong>.</Funnel>

  <QueMide a={r.alcance} />

  <Metodologia meta={meta} />

  {r.relacionadas.length > 0 && (
    <section>
      <Kicker>relacionadas</Kicker>
      <Titulo texto="Comparaciones relacionadas">Comparaciones relacionadas</Titulo>
      <ul>{r.relacionadas.map((x: any) => <li><a href={x.href}><span data-nombre>{x.texto}</span></a></li>)}</ul>
    </section>
  )}

  <script type="application/ld+json" set:html={datasetLd} />
  <section class="faq">
    <script type="application/ld+json" set:html={faqLd} />
    <Kicker>preguntas</Kicker>
    <Titulo texto={`Preguntas frecuentes sobre ${r.que}`}>Preguntas frecuentes sobre <span data-nombre>{r.que}</span></Titulo>
    <details><summary><strong>{q1.q}</strong></summary>
      <p>{g ? <>En {r.que}, el benchmark no separa {g.primeros ? <>a los primeros <Cifra v={g.n} /></> : <>a estos <Cifra v={g.n} /> modelos de la cima</>}. El más barato del grupo es <Modelo m={g.barato} fuerte />. No hay un único «mejor»: {porQueEmpatan}.</>
        : s ? <>Según nuestro benchmark, <Modelo m={s.lider} fuerte /> queda solo arriba en {r.que} con <Eje x={s.lider} ag={ag} largo />: {porQueSepara}.</>
        : <><Modelo m={r.filas[0]} fuerte />, entre los modelos que pasan el piso de calidad de esta página.</>}</p></details>
    <details><summary><strong>{faq[1].q}</strong></summary>
      <p>Si tu caso es muy distinto a {r.que} (por ejemplo, necesitas razonamiento profundo, tool calling crítico o privacidad extrema), probablemente haya mejores opciones. Usa la <a href="/">calculadora</a> para ajustar pesos por caso.</p></details>
    <details><summary><strong>{faq[2].q}</strong></summary>
      <p>De un benchmark abierto con <Cifra v={meta.runs_k} suf="+" /> runs reales y LLM-as-Judge (<Nombre>Phi-4</Nombre>, de Microsoft, vía OpenRouter, sin conflicto de interés). Código y resultados en <a href="https://github.com/ctala/ai-benchmarks-alternativos" target="_blank" rel="noopener">GitHub</a>.</p></details>
    <details><summary><strong>{faq[3].q}</strong></summary>
      <p>Con cada lote de modelos nuevos. La fecha de actualización está al inicio. Filtra la versión más reciente en la <a href="/">calculadora</a>.</p></details>
  </section>

  <section class="cta-block">
    <Kicker>calculadora</Kicker>
    <Titulo texto="Prueba la calculadora con tu caso real">Prueba la calculadora con tu caso real</Titulo>
    <p>Ajusta presupuesto, calidad mínima y tipo de tarea sobre <Cifra v={meta.modelos_testeados} /> modelos medidos.</p>
    <a href="/" class="enlace-flecha">Ir a la calculadora →</a>
  </section>
</Base>
