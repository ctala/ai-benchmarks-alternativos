{
  "name": "benchmark-sitio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "datos": "../.venv/bin/python ../benchmarks/exportar_sitio.py",
    "prebuild": "npm run datos && ../.venv/bin/python ../benchmarks/check_registro.py",
    "build": "astro build",
    "postbuild": "../.venv/bin/python ../benchmarks/check_registro.py --dist dist",
    "dev": "npm run datos && astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.4"
  }
}
